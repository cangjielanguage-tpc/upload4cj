import upload4cj.*
import std.fs.*
import std.io.*
import std.collection.*
import net.http.*

@Test
public class TestDiskFileItemFactory {
    /***
        public init()
        public func getRepository():Option<Directory>
        测试场景: 空构造，默认返回None
    ***/
    @TestCase
    func testDiskFileItemFactory01(): Unit {
        let dff = DiskFileItemFactory()
        var flag = 1
        match (dff.getRepository()) {
            case Some(_) => ()
            case None => flag = 0
        }
        @Assert(flag, 0)
    }
}
